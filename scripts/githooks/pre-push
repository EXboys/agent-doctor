#!/usr/bin/env bash
# Hard local gate:
#   1) Every push → fmt-check + clippy (same as CI)
#   2) Pushing v* tags → full release-preflight (fmt + clippy + tests [+ desktop])
# Install: ./scripts/install-git-hooks.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" || ! -f "$ROOT/scripts/check.sh" ]]; then
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi
cd "$ROOT"

# --- Always: fmt + clippy before anything reaches the remote ---------------
if [[ "${AGENT_DOCTOR_SKIP_LINT:-}" == "1" ]]; then
  echo "pre-push: AGENT_DOCTOR_SKIP_LINT=1 — skipping fmt/clippy (DO NOT use for real work)" >&2
else
  echo "pre-push: running fmt-check + clippy (./scripts/check.sh lint)…" >&2
  ./scripts/check.sh lint
  echo "pre-push: lint OK" >&2
fi

# --- Extra: v* tag pushes need full release-preflight ----------------------
if [[ "${AGENT_DOCTOR_SKIP_RELEASE_PREFLIGHT:-}" == "1" ]]; then
  echo "pre-push: AGENT_DOCTOR_SKIP_RELEASE_PREFLIGHT=1 — skipping release gate" >&2
  exit 0
fi

stamp_path="$ROOT/.git/agent-doctor-preflight.sha"
need_gate=0
tag_commits=()

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*)
      if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
      fi
      # Annotated tags: local_sha is the tag object; peel to the commit.
      commit_sha="$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || true)"
      if [[ -z "$commit_sha" ]]; then
        echo "pre-push: could not resolve commit for $remote_ref ($local_sha)" >&2
        exit 1
      fi
      need_gate=1
      tag_commits+=("$commit_sha")
      echo "pre-push: detected tag push $remote_ref -> commit ${commit_sha:0:8}" >&2
      ;;
  esac
done

if [[ "$need_gate" -eq 0 ]]; then
  exit 0
fi

unique_commits=()
for sha in "${tag_commits[@]}"; do
  skip=0
  for existing in "${unique_commits[@]+"${unique_commits[@]}"}"; do
    if [[ "$existing" == "$sha" ]]; then
      skip=1
      break
    fi
  done
  if [[ "$skip" -eq 0 ]]; then
    unique_commits+=("$sha")
  fi
done

for sha in "${unique_commits[@]}"; do
  if [[ -f "$stamp_path" ]] && [[ "$(cat "$stamp_path")" == "$sha" ]]; then
    echo "pre-push: release-preflight stamp OK for ${sha:0:8}" >&2
    continue
  fi
  echo "pre-push: running ./scripts/check.sh release-preflight for ${sha:0:8}…" >&2
  if [[ "$(git rev-parse HEAD)" != "$sha" ]]; then
    echo "pre-push: HEAD is not $sha — checkout that commit (or run release-preflight there) before pushing the tag." >&2
    exit 1
  fi
  ./scripts/check.sh release-preflight
done

exit 0
