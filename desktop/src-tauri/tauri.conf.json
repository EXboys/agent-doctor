{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Doctor",
  "version": "0.1.36",
  "identifier": "com.agentdoctor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bash scripts/prebuild-cli.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Doctor",
        "width": 420,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RjUyRTYwMTMwREQ0RjQKUldUMDFBMFRZQzcxdGhUQzJhbWFoQlVGQlJ4aUxIZ0JiWW5jZkJUdlo3TjFvS3llNEJTYlJBa04K",
      "endpoints": [
        "https://agent-doctor.oss-cn-shenzhen.aliyuncs.com/desktop/latest.json",
        "https://github.com/EXboys/agent-doctor/releases/latest/download/latest.github.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
